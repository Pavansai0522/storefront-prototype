# Supabase (required for production catalog + /admin)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Store lookup (from admin client record after npm run seed:bala)
VITE_CLIENT_SLUG=bala-mobiles
VITE_CLIENT_ID=client-bala-1

# Admin (/admin) — superadmin email override (comma-separated)
VITE_SUPERADMIN_EMAIL=your-superadmin@email.com

# Product images — your site's upload API (NOT r2.cloudflarestorage.com)
VITE_PRODUCT_IMAGE_UPLOAD_URL=/api/upload-product-image
# Optional local dev origin (defaults to relative /api/... when empty)
# VITE_STOREFRONT_ORIGIN=http://localhost:5173

# Server-only on Vercel — R2_* required for image upload API.
# Use VITE_SUPABASE_* for auth (must match the built admin). Do NOT set wrong SUPABASE_* overrides.
# Optional only if identical to VITE_* (otherwise omit):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=bala-mobiles-products
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
