# Template only — copy to admin/.env and replace every placeholder with your real values.
# This file is safe to commit; admin/.env is gitignored and holds secrets.

# Supabase → Project Settings → API (same project as watches-store-v2)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Same email as SUPERADMIN_EMAIL in the repo root .env (not read from here unless VITE_ prefixed)
VITE_SUPERADMIN_EMAIL=your-superadmin@email.com

# Never add SUPERADMIN_PASSWORD here — root .env only (setup scripts; not bundled into the browser).
