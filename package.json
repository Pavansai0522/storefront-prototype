{
  "name": "my-agency",
  "private": true,
  "overrides": {
    "tailwindcss": "3.4.17"
  },
  "workspaces": [
    "client",
    "server",
    "liquor-store-v1",
    "watches-store-v2",
    "packages/admin-ui"
  ],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "dev:liquor": "npm run dev -w liquor-store-v1",
    "dev:watches": "npm run dev -w watches-store-v2",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "build:liquor": "npm run build -w liquor-store-v1",
    "build:watches": "npm run build -w watches-store-v2",
    "build": "npm run build:client && npm run build:liquor && npm run build:watches && npm run build:server",
    "lint:client": "npm run lint -w client",
    "lint:watches": "npm run lint -w watches-store-v2",
    "seed:watches": "tsx scripts/seed-watches-catalog.ts",
    "setup:supabase": "tsx scripts/setup-supabase-full.ts",
    "fix:superadmin-profile": "tsx scripts/fix-superadmin-profile.ts",
    "reset:admin-auth": "tsx scripts/reset-admin-auth.ts",
    "cleanup:pr-watches-only": "tsx scripts/cleanup-pr-watches-only.ts",
    "create:store-admin": "tsx scripts/create-store-admin.ts",
    "ensure:pr-watches-users": "tsx scripts/ensure-pr-watches-users.ts",
    "set:pr-watches-url": "tsx scripts/set-pr-watches-live-url.ts",
    "seed:bala": "tsx scripts/seed-bala-mobiles.ts",
    "seed:liquor": "tsx scripts/seed-liquor-store.ts",
    "db:migrate": "tsx scripts/apply-sql-migration.ts"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.21.0",
    "tsx": "^4.22.0"
  }
}
