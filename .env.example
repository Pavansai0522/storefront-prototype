# Cloud Supabase (for npm run setup:supabase, seed:*, db:migrate)
# URL: use either name (seed scripts accept VITE_SUPABASE_URL too)
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Service role (secret) — required for seed scripts; never expose in the storefront
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# alias:
# SUPABASE_SECRET_KEY=your-service-role-key

# Anon / publishable key — storefront (liquor-store-v1/.env)
VITE_SUPABASE_ANON_KEY=your-anon-key
# Database password (Dashboard → Project Settings → Database) — for npm run db:migrate
SUPABASE_DB_PASSWORD=your-database-password

# Bala Mobiles seed (npm run seed:bala)
BALA_STORE_ADMIN_EMAIL=owner@balamobiles.example
BALA_STORE_ADMIN_PASSWORD=choose-a-strong-password
# Optional: delete Unsplash/empty-image products when re-seeding
# BALA_CLEAR_MOCK_CATALOG=true
