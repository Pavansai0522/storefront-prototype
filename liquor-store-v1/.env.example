# Supabase (required for production catalog + /admin)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Store lookup (slug from admin client record)
VITE_CLIENT_SLUG=united-liquors
VITE_CLIENT_ID=client-liquor-1

# Admin (/admin) — superadmin email override (comma-separated)
VITE_SUPERADMIN_EMAIL=your-superadmin@email.com

# Product images — your site's upload API (NOT r2.cloudflarestorage.com)
VITE_PRODUCT_IMAGE_UPLOAD_URL=/api/upload-product-image
# Optional local dev origin (defaults to relative /api/... when empty)
# VITE_STOREFRONT_ORIGIN=http://localhost:3000

# Server-only — required on Vercel for /api/upload-product-image (copy from VITE_* values)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=united-liquors-products
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
